meta {
  name: chat-preventa
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "user_id": "bruno-preventa",
    "texto": "¿Tienen la polera azul en talla M?"
  }
}

assert {
  res.status: eq 200
  res.body.ruta: eq preventa
}

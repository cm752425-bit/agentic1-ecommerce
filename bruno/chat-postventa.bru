meta {
  name: chat-postventa
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/chat
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "user_id": "bruno-postventa",
    "texto": "Mi pedido 4521 llegó roto"
  }
}

assert {
  res.status: eq 200
  res.body.ruta: eq postventa
}
